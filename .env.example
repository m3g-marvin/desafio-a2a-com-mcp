# Configuracao para executar o fluxo do avaliador localmente.
# Requisitos: Node.js 20+, npm e Python 3.10+.
#
# 1. Copie este arquivo: cp .env.example .env
# 2. Gere uma chave e preencha REQUEST_STATE_SECRET no .env com a saida:
#    python3 -c 'import secrets; print(secrets.token_hex(32))'
# 3. Na raiz do projeto, suba os processos em terminais separados:
#    Terminal 1: npm run start:mcp
#    Terminal 2: npm run start:agent
#    Terminal 3: python3 validador/validar.py --agente http://localhost:7300 --mcp http://localhost:7301
#
# Os dois processos carregam o .env da raiz automaticamente.
# Variaveis ja definidas no ambiente do terminal tem prioridade sobre o arquivo.
# Reinicie os dois processos antes do validador para restaurar a agenda.
# No teste de retomada, reinicie apenas o MCP, preservando a mesma chave.
# O requestState expira em 10 minutos; nao gere outra chave entre pedido e retry.
# O .env esta no .gitignore. Nunca publique a chave preenchida.

# Obrigatoria para o MCP: hexadecimal com pelo menos 32 bytes aleatorios
# (64 caracteres hexadecimais). Substitua o marcador pela chave gerada.
REQUEST_STATE_SECRET=REPLACE_WITH_YOUR_SECRET

# Porta do servidor MCP. O endpoint HTTP e /mcp.
MCP_PORT=7301

# Porta do agente A2A. O endpoint JSON-RPC e /a2a.
AGENT_PORT=7300

# Endereco usado pelo agente para chamar o MCP; inclua /mcp.
MCP_URL=http://127.0.0.1:7301/mcp

# URL base publicada no Agent Card; sem /a2a e sem barra final.
AGENT_URL=http://127.0.0.1:7300
